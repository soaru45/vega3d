# Variáveis Globais de Ambiente (Desenvolvimento)
# Utilize este arquivo como referência. Para testes locais, copie para .env.local

# Banco de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vega3d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vega3d?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Autenticação (Clerk/Auth0 - Chaves falsas para dev)
NEXT_PUBLIC_AUTH_PUBLISHABLE_KEY=pk_test_12345
AUTH_SECRET_KEY=sk_test_12345

# URLs Base
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000
